<Page x:Class="SoundCloudWP.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="#101010">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="20,18,20,12">
      <TextBlock Text="SOUNDCLOUD" Foreground="#FF5500" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="WP" Foreground="White" FontSize="42" FontWeight="Light" Margin="0,-8,0,12"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" PlaceholderText="Search tracks" KeyDown="SearchBox_KeyDown"/>
        <Button Grid.Column="1" Content="SEARCH" Click="Search_Click" Margin="8,0,0,0"/>
      </Grid>
      <TextBlock x:Name="StatusText" Text="Open Settings and enter your API credential." Foreground="#B0B0B0" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <ProgressRing x:Name="BusyRing" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF5500"/>
      <ListView x:Name="ResultsList" IsItemClickEnabled="True" ItemClick="ResultsList_ItemClick">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Margin="14,6" Height="76">
              <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Background="#292929"><Image Source="{Binding DisplayArtwork}" Stretch="UniformToFill"/></Border>
              <StackPanel Grid.Column="1" Margin="12,6">
                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Artist}" Foreground="#A0A0A0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="8"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
    <Grid Grid.Row="2" Background="#202020" Margin="14,10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="NowTitle" Text="Not playing" Foreground="White" FontSize="17" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="NowDetail" Text="Feasibility build 0.1" Foreground="#A0A0A0" FontSize="13"/>
      </StackPanel>
      <Button Grid.Column="1" Content="SETTINGS" Click="Settings_Click"/>
      <MediaElement x:Name="Player" Grid.Row="1" Grid.ColumnSpan="2" AutoPlay="True" AudioCategory="ForegroundOnlyMedia" MediaOpened="Player_MediaOpened" MediaFailed="Player_MediaFailed" Visibility="Collapsed"/>
    </Grid>
    <Grid x:Name="SettingsPanel" Grid.RowSpan="3" Background="#F0101010" Visibility="Collapsed">
      <StackPanel Margin="24,36">
        <TextBlock Text="SETTINGS" Foreground="White" FontSize="36" FontWeight="Light"/>
        <TextBlock Text="SoundCloud Client ID" Foreground="#C0C0C0" Margin="0,28,0,4"/>
        <TextBox x:Name="ClientIdBox" PlaceholderText="Client ID"/>
        <TextBlock Text="Access token (optional)" Foreground="#C0C0C0" Margin="0,16,0,4"/>
        <PasswordBox x:Name="AccessTokenBox" PasswordChar="●"/>
        <TextBlock Text="The secret is intentionally not stored in this phone build. OAuth will use a token broker in the next milestone." Foreground="#909090" TextWrapping="Wrap" Margin="0,12,0,20"/>
        <StackPanel Orientation="Horizontal"><Button Content="SAVE" Click="SaveSettings_Click"/><Button Content="CANCEL" Click="CloseSettings_Click" Margin="8,0,0,0"/></StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
